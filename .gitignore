# Only the DVR project belongs in this repository (this folder also holds other work)
/*
!/.gitignore
!/.gitattributes
!/README.md
!/ROADMAP.md
!/LICENSE
!/dvr-recorder/
!/dvr-probe/
!/imu-probe/
!/decoder-board/

