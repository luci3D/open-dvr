#!/bin/sh
# Open DVR boot hook for the COOAI / BAYCKRC "MINI DVR" board (GK7202V300 + TP2850).
# The stock firmware's /boot/app/run.sh does "mount /dev/mmcblk0p1 /home; cd /home;
# ./encrypt" as root on every boot, right before "cd /boot; ./appRecord &", so this
# file runs there.
#
# It swaps the stock recorder for ours with RAM-only bind mounts (nothing on the board's
# flash changes): /home/dvr/start.sh appears as /boot/appRecord, and the stock recorder
# stays reachable as /dev/appRecord.stock for start.sh's fallback.
#
# Files in the SD card root that change what happens (empty files are fine):
#   stock         run the stock recorder instead of ours
#   encrypt.orig  the card's original "encrypt" (if it had one); run last
cd /home || exit 0

# Developer extras (UART shell, IMU test, button/LED probe); not part of releases.
# dev.sh sets DVR_USE_STOCK=1 when this boot has to run the stock recorder.
[ -f /home/dvr/dev.sh ] && . /home/dvr/dev.sh

if [ -z "$DVR_USE_STOCK" ] && [ ! -f /home/stock ] && [ -f /home/dvr/dvrrec ] && [ -f /home/dvr/start.sh ]; then
    touch /dev/appRecord.stock && mount -o bind /boot/appRecord /dev/appRecord.stock
    mount -o bind /home/dvr/start.sh /boot/appRecord
    echo "open DVR active: rc=$? at uptime $(cut -d' ' -f1 /proc/uptime)" > /home/dvr/boot.txt
fi

[ -f /home/encrypt.orig ] && ./encrypt.orig
exit 0
